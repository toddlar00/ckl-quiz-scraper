CKL_USERNAME=your_email@example.com
CKL_PASSWORD=your_password
CKL_BASE_URL=https://coreknowledgeforlawyers.com

# West Academic credentials (optional — for --site westacademic)
# WA_USERNAME=your_email@example.com
# WA_PASSWORD=your_password
# WA_BASE_URL=https://subscription.westacademic.com
# WA_LOGIN_METHOD=form   # "form" or "google"

# Proxy / VPN — route all browser traffic through a proxy
# Supports HTTP, HTTPS, and SOCKS5 (e.g. for Tor or a VPN SOCKS tunnel)
# CKL_PROXY_URL=http://proxy.example.com:8080
# CKL_PROXY_URL=socks5://127.0.0.1:1080
# CKL_PROXY_URL=http://user:pass@proxy.example.com:8080

# Optional settings
# CKL_HEADLESS=true
# CKL_PAGE_LOAD_TIMEOUT=30
# CKL_IMPLICIT_WAIT=10
# CKL_REQUEST_DELAY=1.0
